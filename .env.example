# Vercel Preview demo mode. Set to true in the Vercel dashboard, for the Preview environment only.
# It stays off unless Vercel also provides VITE_VERCEL_ENV=preview, so do not set that by hand.
VITE_DEMO_MODE=false

# KakaoTalk sharing (Kakao Developers > 앱 > 플랫폼 키 > JavaScript 키). It is a public key that
# ships in the bundle; the domains that may use it are set in the Kakao console. Leave it empty to
# keep sharing as link copying.
VITE_KAKAO_JS_KEY=

# Backend connection. Without VITE_API_MODE=server the app keeps the in-memory sample flow
# (no sign-in, no requests). Copy these to .env.local to sign in against the real server.
# The backend allows http://localhost:5173 and https://bok-jak-bok-jak-fe.vercel.app only, so
# Vercel Preview URLs are refused by CORS.
# All three are public values. Never put a secret here: every VITE_ value ends up in the bundle,
# so the dev-login key (X-Dev-Login-Key) must stay in Swagger/Postman and out of this file.
VITE_API_MODE=
VITE_API_BASE_URL=https://bokjak-api.koreacentral.cloudapp.azure.com
VITE_GOOGLE_CLIENT_ID=825702442416-0c2q9s0e5skjo7kg1edoe5l2p007s6s1.apps.googleusercontent.com
