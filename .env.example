# Vercel Preview demo mode. Set to true in the Vercel dashboard, for the Preview environment only.
# It stays off unless Vercel also provides VITE_VERCEL_ENV=preview, so do not set that by hand.
VITE_DEMO_MODE=false

# KakaoTalk sharing (Kakao Developers > 앱 > 플랫폼 키 > JavaScript 키). It is a public key that
# ships in the bundle; the domains that may use it are set in the Kakao console. Leave it empty to
# keep sharing as link copying.
VITE_KAKAO_JS_KEY=
