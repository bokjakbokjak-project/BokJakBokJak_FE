# Normalize text files to LF on every platform
* text=auto eol=lf

# Keep third-party license text verbatim
public/licenses/** -whitespace

# Keep binary files byte-for-byte
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.avif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.eot binary
*.pdf binary
*.mp4 binary
*.webm binary
