# User test build (docs/user-test/README.md). Loaded only by `--mode usertest`, so the normal dev
# server and the Vercel deployments never read it. Every value here is public and ships in the
# bundle; never put a secret here. Personal overrides go in .env.usertest.local (gitignored).
VITE_API_MODE=server
VITE_API_BASE_URL=https://bokjak-api.koreacentral.cloudapp.azure.com
VITE_GOOGLE_CLIENT_ID=825702442416-0c2q9s0e5skjo7kg1edoe5l2p007s6s1.apps.googleusercontent.com

VITE_USER_TEST=true
# 핵심 체험 | 전체 서비스 switch (docs/experience/README.md).
VITE_EXPERIENCE=true
VITE_USER_TEST_COHORT=local-2026-11

# Temporary shared values for development, not decided yet. Not guessed from any real participant.
VITE_USER_TEST_GENDER=FEMALE
VITE_USER_TEST_BIRTH_YEAR=2005
VITE_USER_TEST_DEPARTMENT=사용자테스트
VITE_USER_TEST_STUDENT_NUMBER=00000000
VITE_USER_TEST_DORMITORY=사용자테스트 기숙사

# Leave off until the server has the feedback API; with it on, saves keep failing with 404.
# VITE_USER_TEST_FEEDBACK_API=on
